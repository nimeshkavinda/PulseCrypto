{
  "name": "@pulsecrypto/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Fastify WebSocket market streaming gateway for PulseCrypto",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "build:shared": "npm --prefix ../shared run build",
    "prebuild": "npm run build:shared",
    "build": "tsc",
    "pretypecheck": "npm run build:shared",
    "typecheck": "tsc --project tsconfig.test.json",
    "predev": "npm run build:shared",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.0.2",
    "@pulsecrypto/shared": "*",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
