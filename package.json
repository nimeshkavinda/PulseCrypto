{
  "name": "pulsecrypto",
  "version": "1.0.0",
  "private": true,
  "description": "PulseCrypto - Real-Time Cryptocurrency Market Streaming Platform",
  "workspaces": [
    "shared",
    "backend",
    "mobile"
  ],
  "scripts": {
    "dev:backend": "docker compose up --build",
    "dev:mobile": "npm --prefix mobile start",
    "build:shared": "npm --prefix shared run build",
    "build:backend": "npm --prefix backend run build",
    "test:shared": "npm --prefix shared run test",
    "test:backend": "npm --prefix backend run test",
    "test:mobile": "npm --prefix mobile run test",
    "test": "npm run test:shared && npm run test:backend && npm run test:mobile",
    "typecheck": "npm --prefix shared run typecheck && npm --prefix backend run typecheck && npm --prefix mobile run typecheck",
    "lint": "eslint shared backend mobile"
  },
  "keywords": [
    "cryptocurrency",
    "market-data",
    "real-time",
    "react-native",
    "fastify",
    "websockets"
  ],
  "author": "Amused Group Candidate",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.70.1"
  }
}
